# This file documents the deployment variables only. Do not put real secrets
# here. Run ./scripts/bootstrap_deployment.sh to create a local .env with
# generated values. The generated .env is ignored by Git.

ENVIRONMENT=development
BACKEND_AUTH_MODE=local_single_user
FRONTEND_AUTH_MODE=local_single_user

# PostgreSQL and Redis
POSTGRES_DB=ontoprompt
POSTGRES_USER=ontoprompt
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://ontoprompt:<generated-postgres-password>@db:5432/ontoprompt
REDIS_URL=redis://redis:6379/0

# Application secrets (generated at deployment time)
SECRET_KEY=
ENCRYPTION_KEY=
FIRST_ADMIN_USER=admin
FIRST_ADMIN_PASSWORD=
UPLOADS_DIR=/uploads

# Optional host directory containing the verified C-MAPSS subset
CMAPSS_FD001_HOST_DIR=./data/cmapss_fd001_demo

# CORS - comma-separated browser origins
CORS_ORIGINS=http://localhost:15173,http://127.0.0.1:15173

# LiteLLM gateway. Provider keys stay empty unless explicitly configured.
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
UI_USERNAME=admin
UI_PASSWORD=
OLLAMA_API_KEY=
MINIMAX_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DASHSCOPE_API_KEY=

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# FalkorDB
FALKORDB_HOST=falkordb
FALKORDB_PORT=6379

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=false
MINIO_DATA_VOLUME=nano-ontoprompt_workbench_minio_data

# ChromaDB
CHROMA_HOST=chromadb
CHROMA_PORT=8001
